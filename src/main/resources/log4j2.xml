<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

    <Properties>
        <Property name="LOG_PATTERN">%d{HH:mm:ss} %-5level %logger{1} - %msg%n</Property>
    </Properties>

    <Appenders>
        <!-- Console with Colors -->
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout>
                <Pattern>%d{HH:mm:ss} %highlight{%-5level}{FATAL=red, ERROR=red, WARN=yellow, INFO=green, DEBUG=blue} %logger{1} - %msg%n</Pattern>
            </PatternLayout>
        </Console>

        <!-- File -->
        <File name="FileLogger" fileName="logs/automation.log" append="false">
            <PatternLayout>
                <Pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %logger{36} - %msg%n</Pattern>
            </PatternLayout>
        </File>

        <!-- Report Portal Appender -->
        <ReportPortalLog4j2Appender name="ReportPortalAppender">
            <PatternLayout pattern="${LOG_PATTERN}"/>
        </ReportPortalLog4j2Appender>
    </Appenders>

    <Loggers>
        <Root level="info">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileLogger"/>
            <AppenderRef ref="ReportPortalAppender"/>
        </Root>

        <!-- Framework Loggers -->
        <Logger name="com.reportportal.automation" level="debug" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileLogger"/>
            <AppenderRef ref="ReportPortalAppender"/>
        </Logger>

        <!-- Suppress verbose Selenium logs -->
        <Logger name="org.openqa.selenium" level="warn" additivity="false">
            <AppenderRef ref="FileLogger"/>
        </Logger>

        <!-- Suppress Report Portal internal logs -->
        <Logger name="com.epam.reportportal" level="warn" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="FileLogger"/>
        </Logger>
    </Loggers>

</Configuration>