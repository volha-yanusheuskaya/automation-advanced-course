<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Test Automation Suite - Class level" parallel="classes" thread-count="3">

    <test name="Login Tests" enabled="true">
        <classes>
            <class name="com.epam.automation.tests.ui.launches_testng.LoginTest"/>
        </classes>
    </test>

    <test name="Launches Sorting Tests" enabled="true">
        <classes>
            <class name="com.epam.automation.tests.ui.launches_testng.LaunchesSortingTest"/>
        </classes>
    </test>

    <test name="Launches Count Data Tests" enabled="true">
        <classes>
            <class name="com.epam.automation.tests.ui.launches_testng.LaunchesCountDataTest"/>
        </classes>
    </test>

    <test name="Launches Comparison Tests" enabled="true">
        <classes>
            <class name="com.epam.automation.tests.ui.launches_testng.LaunchesComparisonTest"/>
        </classes>
    </test>

    <test name="Launches Removal Tests" enabled="true">
        <classes>
            <class name="com.epam.automation.tests.ui.launches_testng.LaunchesRemovalTest"/>
        </classes>
    </test>

    <test name="Launches View Tests" enabled="true">
        <classes>
            <class name="com.epam.automation.tests.ui.launches_testng.LaunchesViewTest"/>
        </classes>
    </test>

</suite>
